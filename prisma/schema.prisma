generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReadingStatus {
  TO_READ
  READING
  READ
  ABANDONED
}

enum ReactionKind {
  LIKE
  TO_READ
}

enum NotificationType {
  REVIEW_LIKE
  COMMENT_LIKE
  REVIEW_COMMENT
  COMMENT_REPLY
  FRIEND_REVIEW
  NEW_FOLLOWER
  BADGE_EARNED
  GROUP_REPLY
  GROUP_MENTION
  GROUP_INVITE
  GROUP_THREAD
}

enum XpReason {
  BOOK_READ
  REVIEW
  JOURNAL_ENTRY
  COMMENT
  LIBRARY_ADD
  FOLLOW
  LIKE_REVIEW
  LIKE_COMMENT
}

enum ReportTargetType {
  USER
  REVIEW
  COMMENT
  GROUP_THREAD
  GROUP_POST
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE_SPEECH
  SPOILER
  INAPPROPRIATE_CONTENT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum UserRole {
  USER
  ADMIN
}

enum AccountTokenType {
  VERIFY_EMAIL
  RESET_PASSWORD
}

enum ModerationActionType {
  NONE
  HIDE
  RESTORE
  SUSPEND
  UNSUSPEND
}

model User {
  id               String    @id @default(cuid())
  name             String?
  username         String?   @unique
  email            String?   @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  sessionVersion   Int       @default(0)
  bio              String?
  role             UserRole  @default(USER)
  suspendedAt      DateTime?
  suspensionReason String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts                 Account[]
  sessions                 Session[]
  library                  UserBook[]
  reviews                  Review[]
  reactions                ReviewReaction[]
  comments                 ReviewComment[]
  commentLikes             ReviewCommentReaction[]
  following                Follow[]                  @relation("following")
  followers                Follow[]                  @relation("followers")
  lists                    BookList[]
  notifications            Notification[]            @relation("notification_recipient")
  actions                  Notification[]            @relation("notification_actor")
  notificationPreference   NotificationPreference?
  preference               UserPreference?
  pushTokens               PushToken[]
  recommendationDismissals RecommendationDismissal[]
  moderationReports        ModerationReport[]
  blockedUsers             UserBlock[]               @relation("blocker")
  blockedBy                UserBlock[]               @relation("blocked")
  legalAcceptances         LegalAcceptance[]
  accountTokens            AccountToken[]
  moderationActions        ModerationAction[]        @relation("moderator")
  xpEvents                 XpEvent[]
  activityDays             ActivityDay[]
  stats                    UserStats?
  badges                   UserBadge[]
  createdGroups            Group[]                   @relation("group_creator")
  groupMemberships         GroupMember[]
  groupInvites             GroupInvite[]             @relation("group_invitee")
  sentGroupInvites         GroupInvite[]             @relation("group_inviter")
  groupThreads             GroupThread[]
  groupPosts               GroupPost[]
  groupThreadReactions     GroupThreadReaction[]
  groupPostReactions       GroupPostReaction[]
  pollVotes                PollVote[]
  readingEntryLikes        ReadingEntryLike[]
}

// Progression : chaque action ne rapporte de l'XP qu'une fois par source (anti-farm).
model XpEvent {
  id        String   @id @default(cuid())
  userId    String
  reason    XpReason
  sourceId  String
  amount    Int
  day       DateTime @db.Date
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reason, sourceId])
  @@index([userId, day])
  @@index([userId, createdAt])
}

model ActivityDay {
  userId      String
  day         DateTime  @db.Date
  xp          Int       @default(0)
  validatedAt DateTime?
  frozen      Boolean   @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
}

model UserStats {
  userId           String    @id
  xpTotal          Int       @default(0)
  journeyStartedAt DateTime?
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastValidatedDay DateTime? @db.Date
  dailyGoal        Int       @default(10)
  streakFreezes    Int       @default(0)
  timezone         String    @default("Europe/Paris")
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeSlug String
  tier      Int
  earnedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeSlug, tier])
  @@index([userId, earnedAt])
}

model UserPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  hideSpoilers Boolean  @default(true)
  theme        String   @default("cosy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LegalAcceptance {
  id             String    @id @default(cuid())
  userId         String
  termsVersion   String
  privacyVersion String
  acceptedAt     DateTime  @default(now())
  ageConfirmedAt DateTime?
  source         String    @default("WEB")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, acceptedAt])
}

model AccountToken {
  id        String           @id @default(cuid())
  userId    String
  type      AccountTokenType
  tokenHash String           @unique
  expiresAt DateTime
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Book {
  id                  String   @id @default(cuid())
  googleBooksVolumeId String?  @unique
  openLibraryKey      String?  @unique
  isbn10              String[] @default([])
  isbn13              String[] @default([])
  title               String
  authors             String[]
  description         String?
  thumbnailUrl        String?
  publishedDate       String?
  publisher           String?
  pageCount           Int?
  language            String?
  genres              String[] @default([])
  source              String   @default("manual")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  libraries                UserBook[]
  reviews                  Review[]
  listEntries              BookListEntry[]
  recommendationDismissals RecommendationDismissal[]
  groups                   Group[]
  groupThreads             GroupThread[]
}

model UserBook {
  id           String        @id @default(cuid())
  userId       String
  bookId       String
  status       ReadingStatus
  isFavorite   Boolean       @default(false)
  showcaseRank Int?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  book           Book            @relation(fields: [bookId], references: [id], onDelete: Cascade)
  readingPeriods ReadingPeriod[]

  @@unique([userId, bookId])
  @@index([status])
  @@index([bookId])
}

model Review {
  id           String    @id @default(cuid())
  userId       String
  bookId       String
  rating       Int
  body         String?
  spoiler      Boolean   @default(false)
  hiddenAt     DateTime?
  hiddenReason String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  book      Book             @relation(fields: [bookId], references: [id], onDelete: Cascade)
  reactions ReviewReaction[]
  comments  ReviewComment[]

  @@unique([userId, bookId])
  @@index([createdAt])
  @@index([bookId])
}

model ReviewReaction {
  id        String       @id @default(cuid())
  reviewId  String
  userId    String
  kind      ReactionKind
  createdAt DateTime     @default(now())

  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reviewId, userId, kind])
  @@index([userId])
}

model ReviewComment {
  id           String    @id @default(cuid())
  reviewId     String
  userId       String
  parentId     String?
  body         String
  hiddenAt     DateTime?
  hiddenReason String?
  // Suppression douce : un commentaire qui a encore des réponses reste dans le fil, sans contenu.
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  review  Review                  @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  ReviewComment?          @relation("comment_thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies ReviewComment[]         @relation("comment_thread")
  likes   ReviewCommentReaction[]

  @@index([reviewId])
  @@index([userId])
  @@index([parentId])
}

model ReviewCommentReaction {
  id        String   @id @default(cuid())
  commentId String
  userId    String
  createdAt DateTime @default(now())

  comment ReviewComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([userId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model ReadingPeriod {
  id         String    @id @default(cuid())
  userBookId String
  startedAt  DateTime?
  finishedAt DateTime?
  isReread   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  userBook UserBook       @relation(fields: [userBookId], references: [id], onDelete: Cascade)
  entries  ReadingEntry[]

  @@index([userBookId, startedAt])
}

model ReadingEntry {
  id         String           @id @default(cuid())
  periodId   String
  entryDate  DateTime         @default(now())
  page       Int?
  percentage Int?
  chapter    String?
  note       String?
  isPublic   Boolean          @default(false)
  kind       ReadingEntryKind @default(NOTE)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  period ReadingPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  likes  ReadingEntryLike[]

  @@index([periodId, entryDate])
  @@index([isPublic, entryDate])
}

model RecommendationDismissal {
  id        String   @id @default(cuid())
  userId    String
  bookId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([userId, bookId])
  @@index([userId])
}

model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model ModerationReport {
  id             String               @id @default(cuid())
  reporterId     String
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  details        String?
  status         ReportStatus         @default(OPEN)
  moderatorNote  String?
  decisionReason String?
  action         ModerationActionType @default(NONE)
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  reporter User @relation(fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model LegalNotice {
  id             String               @id @default(cuid())
  trackingCode   String               @unique
  reporterEmail  String
  targetUrl      String
  legalGround    String
  explanation    String
  goodFaith      Boolean
  status         ReportStatus         @default(OPEN)
  decisionReason String?
  action         ModerationActionType @default(NONE)
  resolvedAt     DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  appeals ModerationAppeal[]

  @@index([status, createdAt])
}

model ModerationAction {
  id            String               @id @default(cuid())
  moderatorId   String?
  reportId      String?
  legalNoticeId String?
  targetType    ReportTargetType
  targetId      String
  action        ModerationActionType
  reason        String
  createdAt     DateTime             @default(now())

  moderator User? @relation("moderator", fields: [moderatorId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId, createdAt])
  @@index([moderatorId, createdAt])
}

model ModerationAppeal {
  id            String       @id @default(cuid())
  legalNoticeId String
  email         String
  reason        String
  status        ReportStatus @default(OPEN)
  response      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  legalNotice LegalNotice @relation(fields: [legalNoticeId], references: [id], onDelete: Cascade)

  @@index([legalNoticeId, createdAt])
  @@index([status, createdAt])
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  title       String
  message     String
  targetUrl   String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User  @relation("notification_recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("notification_actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
  @@index([actorId])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  enabled              Boolean  @default(true)
  likesEnabled         Boolean  @default(true)
  commentsEnabled      Boolean  @default(true)
  friendReviewsEnabled Boolean  @default(true)
  followersEnabled     Boolean  @default(true)
  groupsEnabled        Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
}

model BookList {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  rating      Float?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries BookListEntry[]

  @@index([userId])
}

model BookListEntry {
  id        String   @id @default(cuid())
  listId    String
  bookId    String
  note      String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  list BookList @relation(fields: [listId], references: [id], onDelete: Cascade)
  book Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([listId, bookId])
  @@index([listId])
  @@index([bookId])
}

// Groupes de lecture, à la manière des clubs Strava : discussions typées, lecture commune, défi et classement.
enum GroupVisibility {
  PUBLIC
  INVITE
}

enum GroupTopic {
  BOOK
  AUTHOR
  GENRE
  CHALLENGE
  FREE
}

enum GroupRole {
  MEMBER
  MODERATOR
}

enum GroupThreadType {
  DEBATE
  POLL
  READALONG
  ANNOUNCEMENT
}

model Group {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String?
  visibility      GroupVisibility @default(PUBLIC)
  topic           GroupTopic      @default(FREE)
  // Auteur, genre ou intitulé du défi quand le groupe ne tourne pas autour d'un livre.
  topicLabel      String?
  bookId          String?
  emblem          String          @default("book")
  rules           String?
  readalongBookId String?
  readalongLabel  String?
  challengeGoal   Int?
  challengeEndsAt DateTime?
  createdById     String
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  createdBy User          @relation("group_creator", fields: [createdById], references: [id], onDelete: Cascade)
  book      Book?         @relation(fields: [bookId], references: [id], onDelete: SetNull)
  members   GroupMember[]
  invites   GroupInvite[]
  threads   GroupThread[]

  @@index([visibility, createdAt])
}

model GroupMember {
  id        String    @id @default(cuid())
  groupId   String
  userId    String
  role      GroupRole @default(MEMBER)
  notifyAll Boolean   @default(false)
  joinedAt  DateTime  @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupInvite {
  id          String   @id @default(cuid())
  groupId     String
  userId      String
  invitedById String
  createdAt   DateTime @default(now())

  group     Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User  @relation("group_invitee", fields: [userId], references: [id], onDelete: Cascade)
  invitedBy User  @relation("group_inviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
}

model GroupThread {
  id           String          @id @default(cuid())
  groupId      String
  authorId     String
  type         GroupThreadType @default(DEBATE)
  title        String
  body         String?
  // Jusqu'où vont les spoilers (« tome 1 », « chapitre 8 ») ; vide = sans spoiler.
  spoilerLevel String?
  bookId       String?
  pinned       Boolean         @default(false)
  hiddenAt     DateTime?
  hiddenReason String?
  lastPostAt   DateTime        @default(now())
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  group     Group                 @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author    User                  @relation(fields: [authorId], references: [id], onDelete: Cascade)
  book      Book?                 @relation(fields: [bookId], references: [id], onDelete: SetNull)
  posts     GroupPost[]
  reactions GroupThreadReaction[]
  poll      Poll?

  @@index([groupId, lastPostAt])
}

model GroupPost {
  id           String    @id @default(cuid())
  threadId     String
  authorId     String
  parentId     String?
  body         String
  hiddenAt     DateTime?
  hiddenReason String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  thread    GroupThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author    User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent    GroupPost?          @relation("group_post_replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   GroupPost[]         @relation("group_post_replies")
  reactions GroupPostReaction[]

  @@index([threadId, createdAt])
  @@index([parentId])
}

model GroupThreadReaction {
  id        String   @id @default(cuid())
  threadId  String
  userId    String
  createdAt DateTime @default(now())

  thread GroupThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
}

model GroupPostReaction {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post GroupPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
}

model Poll {
  id       String    @id @default(cuid())
  threadId String    @unique
  question String
  closesAt DateTime?

  thread  GroupThread  @relation(fields: [threadId], references: [id], onDelete: Cascade)
  options PollOption[]
  votes   PollVote[]
}

model PollOption {
  id       String @id @default(cuid())
  pollId   String
  label    String
  position Int    @default(0)

  poll  Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  votes PollVote[]

  @@index([pollId])
}

model PollVote {
  id        String   @id @default(cuid())
  pollId    String
  optionId  String
  userId    String
  createdAt DateTime @default(now())

  poll   Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  option PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  user   User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId])
  @@index([optionId])
}

enum ReadingEntryKind {
  NOTE
  QUOTE
}

model ReadingEntryLike {
  id        String   @id @default(cuid())
  entryId   String
  userId    String
  createdAt DateTime @default(now())

  entry ReadingEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([entryId, userId])
  @@index([userId])
}
